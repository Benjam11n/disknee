generator client {
  provider = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Difficulty {
  EASY
  MODERATE
  HARD
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory UserInventory[]
  sessions  Session[]

  @@map("users")
}

model Exercise {
  id            String     @id @default(cuid())
  title         String
  estimatedMins Int
  difficulty    Difficulty
  done          Boolean    @default(false)
  planId        String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@map("exercises")
}

model Plan {
  id        String   @id @default(cuid())
  date      DateTime
  title     String
  when      String   // Display time like "Sat 6:00 pm"
  createdAt DateTime @default(now())
  exercises Exercise[]

  @@map("plans")
}

model Appointment {
  id               String    @id @default(cuid())
  start            DateTime
  doctorName       String
  doctorSpecialty  String
  locationName     String
  locationAddr     String
  createdAt        DateTime  @default(now())

  @@map("appointments")
}

model Session {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  duration      Int?      // Duration in seconds
  repsCompleted Int       @default(0)
  accuracy      Int       @default(0)
  maxAccuracy   Int?
  videoUrl      String?
  notes         String?
  exerciseId    String?   // Optional link to an exercise
  userId        String?   // Optional link to a user
  createdAt     DateTime  @default(now())

  // Relations
  reflection Reflection?
  exercise    Exercise?  @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("sessions")
}

model Reflection {
  id        String   @id @default(cuid())
  sessionId String   @unique
  rating    Int      // 1-5 session rating
  fatigue   Int      // 1-5 fatigue level
  feedback  String?
  createdAt DateTime @default(now())

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("reflections")
}

view leaderboardByScore {
  rank               Int
  name               String
  weeks              Int
  accuracypercentage Int
  score              Int

  @@map("leaderboard_by_score")
}

view leaderboardByAccuracy {
  rank               Int
  name               String
  weeks              Int
  accuracypercentage Int
  score              Int

  @@map("leaderboard_by_accuracy")
}

model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int      // Cost in points
  type        String   // e.g., "hat", "accessory"
  icon        String   // Emoji or icon representation
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  inventory UserInventory[]

  @@map("shop_items")
}

model UserInventory {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  isEquipped Boolean  @default(false)
  purchasedAt DateTime @default(now())

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  item    ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("user_inventory")
}