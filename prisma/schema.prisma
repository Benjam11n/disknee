generator client {
  provider = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Difficulty {
  EASY
  MODERATE
  HARD
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Exercise {
  id            String     @id @default(cuid())
  title         String
  estimatedMins Int
  difficulty    Difficulty
  done          Boolean    @default(false)
  planId        String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@map("exercises")
}

model Plan {
  id        String   @id @default(cuid())
  date      DateTime
  title     String
  when      String   // Display time like "Sat 6:00 pm"
  createdAt DateTime @default(now())
  exercises Exercise[]

  @@map("plans")
}

model Appointment {
  id               String    @id @default(cuid())
  start            DateTime
  doctorName       String
  doctorSpecialty  String
  locationName     String
  locationAddr     String
  createdAt        DateTime  @default(now())

  @@map("appointments")
}

model Session {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  duration      Int?      // Duration in seconds
  repsCompleted Int       @default(0)
  accuracy      Int       @default(0)
  maxAccuracy   Int?
  videoUrl      String?
  notes         String?
  exerciseId    String?   // Optional link to an exercise
  createdAt     DateTime  @default(now())

  // Relations
  reflection Reflection?
  exercise    Exercise?  @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@map("sessions")
}

model Reflection {
  id        String   @id @default(cuid())
  sessionId String   @unique
  rating    Int      // 1-5 session rating
  fatigue   Int      // 1-5 fatigue level
  feedback  String?
  createdAt DateTime @default(now())

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("reflections")
}

view leaderboardByScore {
  rank               Int
  name               String
  weeks              Int
  accuracyPercentage Int
  score              Int

  @@map("leaderboard_by_score")
}

view leaderboardByAccuracy {
  rank               Int
  name               String
  weeks              Int
  accuracyPercentage Int
  score              Int

  @@map("leaderboard_by_accuracy")
}