generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExerciseDifficulty {
  EASY
  MODERATE
  HARD
}

enum ReviewStatus {
  REVIEWED
  NOT_SENT
  PENDING
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  points        Int      @default(0)
  streakPoints  Int      @default(0) // Points earned from streaks
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventory        UserInventory[]
  sessions         Session[]
  accounts         Account[]
  exerciseSessions ExerciseSession[]
  dailyCheckIns    DailyCheckIn[]
  userStreak       UserStreak?

  weekReports      WeekReport[]
  clinicianReviews WeekReport[] @relation("ClinicianReviews")

  @@map("users")
}

model Exercise {
  id            String             @id @default(cuid())
  title         String
  estimatedMins Int
  difficulty    ExerciseDifficulty
  done          Boolean            @default(false)
  sequence      Int
  planId        String
  videoUrl      String? // URL for demo video
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  plan     Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions ExerciseSession[]

  @@map("exercises")
}

model Plan {
  id        String     @id @default(cuid())
  date      DateTime
  title     String
  when      String
  createdAt DateTime   @default(now())
  exercises Exercise[]

  @@map("plans")
}

model Appointment {
  id              String   @id @default(cuid())
  start           DateTime
  doctorName      String
  doctorSpecialty String
  locationName    String
  locationAddr    String
  createdAt       DateTime @default(now())

  @@map("appointments")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model ExerciseSession {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  duration      Int?
  repsCompleted Int       @default(0)
  accuracy      Int       @default(0)
  maxAccuracy   Int?
  videoUrl      String?
  notes         String?
  exerciseId    String?
  userId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Snapshot / denormalised fields
  pointsEarned  Int?
  exerciseTitle String?
  difficulty    ExerciseDifficulty?

  reflection Reflection?
  exercise   Exercise?   @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("exercise_sessions")
}

model Reflection {
  id                String   @id @default(cuid())
  exerciseSessionId String   @unique
  rating            Int
  fatigue           Int
  feedback          String?
  createdAt         DateTime @default(now())

  exerciseSession ExerciseSession @relation(fields: [exerciseSessionId], references: [id], onDelete: Cascade)

  @@map("reflections")
}

view leaderboardByScore {
  rank               Int
  name               String
  weeks              Int
  accuracypercentage Int
  score              Int

  @@map("leaderboard_by_score")
}

view leaderboardByAccuracy {
  rank               Int
  name               String
  weeks              Int
  accuracypercentage Int
  score              Int

  @@map("leaderboard_by_accuracy")
}

model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  type        String
  icon        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory UserInventory[]

  @@map("shop_items")
}

model UserInventory {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  isEquipped  Boolean  @default(false)
  purchasedAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("user_inventory")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

enum Mood {
  ENERGIZED
  OKAY
  TIRED
  FRUSTRATED
}

model DailyCheckIn {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  mood      Mood
  points    Int      @default(0) // Points earned from this check-in
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_check_ins")
}

model UserStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastCheckInDate DateTime?
  frozenUntil     DateTime? // Streak freeze power-up
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

/**
 * WeekReport:
 * - one per user per weekStart (normalized to Monday 00:00)
 * - per-week review status, clinician feedback, and aggregates
 */
model WeekReport {
  id              String       @id @default(cuid())
  userId          String
  weekStart       DateTime
  status          ReviewStatus @default(NOT_SENT)
  feedback        String?
  totalExercises  Int          @default(0)
  avgSatisfaction Float?
  avgFatigue      Float?
  totalPoints     Int          @default(0)
  clinicianId     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinician User? @relation("ClinicianReviews", fields: [clinicianId], references: [id], onDelete: SetNull)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
  @@map("week_reports")
}
