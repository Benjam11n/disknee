
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExerciseDifficulty {
  EASY
  MODERATE
  HARD
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  points        Int      @default(0)
  streakPoints  Int      @default(0) // Points earned from streaks
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventory        UserInventory[]
  sessions         Session[]
  accounts         Account[]
  exerciseSessions ExerciseSession[]
  dailyCheckIns    DailyCheckIn[]
  userStreak        UserStreak?

  @@map("users")
}

model Exercise {
  id            String             @id @default(cuid())
  title         String
  estimatedMins Int
  difficulty    ExerciseDifficulty
  done          Boolean            @default(false)
  sequence      Int                // Order in which exercises should be completed
  planId        String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  plan     Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  sessions ExerciseSession[]

  @@map("exercises")
}

model Plan {
  id        String     @id @default(cuid())
  date      DateTime
  title     String
  when      String // Display time like "Sat 6:00 pm"
  createdAt DateTime   @default(now())
  exercises Exercise[]

  @@map("plans")
}

model Appointment {
  id              String   @id @default(cuid())
  start           DateTime
  doctorName      String
  doctorSpecialty String
  locationName    String
  locationAddr    String
  createdAt       DateTime @default(now())

  @@map("appointments")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model ExerciseSession {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  duration      Int? // Duration in seconds
  repsCompleted Int       @default(0)
  accuracy      Int       @default(0)
  maxAccuracy   Int?
  videoUrl      String?
  notes         String?
  exerciseId    String? // Optional link to an exercise
  userId        String? // User who performed the exercise
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  reflection Reflection?
  exercise   Exercise?   @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exercise_sessions")
}

model Reflection {
  id                String   @id @default(cuid())
  exerciseSessionId String   @unique
  rating            Int // 1-5 session rating
  fatigue           Int // 1-5 fatigue level
  feedback          String?
  createdAt         DateTime @default(now())

  // Relations
  exerciseSession ExerciseSession @relation(fields: [exerciseSessionId], references: [id], onDelete: Cascade)

  @@map("reflections")
}

view leaderboardByScore {
  rank               Int
  name               String
  weeks              Int
  accuracypercentage Int
  score              Int

  @@map("leaderboard_by_score")
}

view leaderboardByAccuracy {
  rank               Int
  name               String
  weeks              Int
  accuracypercentage Int
  score              Int

  @@map("leaderboard_by_accuracy")
}

model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int // Cost in points
  type        String // e.g., "hat", "accessory"
  icon        String // Emoji or icon representation
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  inventory UserInventory[]

  @@map("shop_items")
}

model UserInventory {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  isEquipped  Boolean  @default(false)
  purchasedAt DateTime @default(now())

  // Relations
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("user_inventory")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

enum Mood {
  ENERGIZED
  OKAY
  TIRED
  FRUSTRATED
}

model DailyCheckIn {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  mood      Mood
  points    Int      @default(0) // Points earned from this check-in
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_check_ins")
}

model UserStreak {
  id               String   @id @default(cuid())
  userId           String   @unique
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastCheckInDate DateTime?
  frozenUntil      DateTime? // Streak freeze power-up
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}
