generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Difficulty {
  EASY
  MODERATE
  HARD
}

model Exercise {
  id            String     @id @default(cuid())
  title         String
  estimatedMins Int
  difficulty    Difficulty
  done          Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("exercises")
}

model Plan {
  id        String   @id @default(cuid())
  date      DateTime
  title     String
  when      String   // Display time like "Sat 6:00 pm"
  createdAt DateTime @default(now())

  @@map("plans")
}

model Appointment {
  id               String    @id @default(cuid())
  start            DateTime
  doctorName       String
  doctorSpecialty  String
  locationName     String
  locationAddr     String
  createdAt        DateTime  @default(now())

  @@map("appointments")
}

model Session {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  duration      Int?      // Duration in seconds
  repsCompleted Int       @default(0)
  accuracy      Int       @default(0)
  maxAccuracy   Int?
  videoUrl      String?
  notes         String?
  createdAt     DateTime  @default(now())

  // Relations
  reflection Reflection?

  @@map("sessions")
}

model Reflection {
  id        String   @id @default(cuid())
  sessionId String   @unique
  rating    Int      // 1-5 session rating
  fatigue   Int      // 1-5 fatigue level
  feedback  String?
  createdAt DateTime @default(now())

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("reflections")
}

model Leaderboard {
  id      String @id @default(cuid())
  rank    Int
  name    String
  weeks   Int
  percent Int

  @@unique([rank])
  @@map("leaderboard")
}